{
    "targets": [
        "template_debug",
        "template_release"
    ],
    "common_flags": "enable_fts5=yes enable_math_functions=yes",
    "default_skip": true,
    "jobs": [
        {
            "name": "Windows (x86_64, MinGW)",
            "os": "windows-latest",
            "platform": "windows",
            "artifact-extension": "dll",
            "flags": "use_mingw=yes",
            "cache-name": "win-x86_64-mingw",
            "skip": false
        },
        {
            "name": "Web (wasm32, No Threads)",
            "os": "ubuntu-22.04",
            "platform": "web",
            "artifact-extension": "nothreads.wasm",
            "flags": "threads=no",
            "cache-name": "web-wasm32-nothreads",
            "skip": false
        },
        {
            "name": "Android (arm64)",
            "os": "ubuntu-22.04",
            "platform": "android",
            "artifact-extension": "so",
            "flags": "arch=arm64",
            "cache-name": "android-arm64",
            "skip": false
        }
    ]
}
